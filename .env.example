# Copy this file to .env and fill it in. Never share or commit .env.

# Port for the API server (the app talks to it through /api)
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Turso (hosted, free). Needed when deployed, because hosts like Render wipe local files.
# Turso dashboard → your database → copy the URL, and Create Token (Read & Write, never expires).
# Leave both empty to keep data in a local file on this computer (server/data/adlogues.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Sign-in emails: choose ONE option ─────────────────────────────────────────

# Option A: Resend (free: 3,000 emails/month, 100/day) → https://resend.com
#   1. Sign up, then API Keys → Create API key, and paste it below.
#   2. Without a verified domain, Resend only delivers to the email you signed up with.
#      To send to both people, add your domain at resend.com/domains (add the DNS records it shows),
#      then set MAIL_FROM to an address on that domain.
RESEND_API_KEY=
# MAIL_FROM=Adlogues Billing <billing@adlogues.com>

# Option B: Gmail (free, no domain needed; sends to anyone)
#   Turn on 2-Step Verification, then Google Account → Security → App passwords, and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# If both are empty, codes are printed in the terminal (development only).

# ──────────────────────────────────────────────────────────────────────────────

# Set to production on the live server (secure cookies; refuses to sign in without email set up)
# NODE_ENV=production

# Optional: where the database file lives (default: server/data/adlogues.db)
# DB_PATH=
